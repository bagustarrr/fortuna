# Переменные окружения. Задаются в Vercel → Settings → Environment Variables.
# НЕ коммитьте реальный токен! Здесь только пример.

# --- обязательные ---
AMO_SUBDOMAIN=kursor                     # поддомен без ".amocrm.ru" (kursor.amocrm.ru → kursor)
AMO_TOKEN=ВСТАВЬТЕ_НОВЫЙ_ТОКЕН_В_VERCEL  # долгоживущий токен amoCRM (старый из чата перевыпустить)

# --- для персонализации (имя ребёнка и время мастер-класса) ---
# Впишите ID (или точное название) полей СДЕЛКИ в amoCRM.
# ID поля видно: откройте сделку → «Настроить» → поле → id в углу.
AMO_FIELD_CHILD=123456                   # поле «Имя ребёнка»
AMO_FIELD_MK=123457                      # поле «Время мастер-класса»

# --- необязательно: переопределить тексты тегов ---
# AMO_TAG_VIDEO=Посмотрел видео-презентацию Нурмаш
# AMO_TAG_FORTUNA=Покрутил колесо Фортуны
# AMO_TAG_DIAGNOSTIC=Прошёл диагностику

# --- необязательно: если страница на другом домене, чем функции ---
# ALLOWED_ORIGIN=https://ваш-домен
