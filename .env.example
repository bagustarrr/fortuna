# Пример переменных окружения. НЕ кладите сюда реальный токен и не коммитьте .env!
# На Vercel эти значения задаются в Settings → Environment Variables.

# Поддомен amoCRM без ".amocrm.ru" (например, если адрес kursor.amocrm.ru → пишем kursor)
AMO_SUBDOMAIN=kursor

# Долгоживущий токен amoCRM (Bearer). Задаётся ТОЛЬКО в секретах Vercel.
AMO_TOKEN=ВСТАВЬТЕ_НОВЫЙ_ТОКЕН_В_НАСТРОЙКАХ_VERCEL

# Какой тег ставить на сделку (необязательно)
AMO_TAG=Крутил колесо фортуны

# Только если страница размещена на другом домене, чем функция (обычно НЕ нужно):
# ALLOWED_ORIGIN=https://ваш-домен.ru
